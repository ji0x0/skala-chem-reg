# 환경변수 템플릿 — 복사해서 .env로 쓴다 (cp .env.example .env)
# .env는 API 키 같은 비밀값이 들어가므로 Git에 올리지 않는다. 이 파일만 커밋한다.
# 단계가 진행되면서 필요한 항목을 아래에 추가한다.

# ── Step 0: 공통 ──
# 로그 수준: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Step 2: 외부 규제 원문 API ──
# 법제처 국가법령정보 Open API 인증키(OC) — open.law.go.kr에서 신청할 때 직접 정한 값 (Step 8 국내 변경 수집)
# 비우면 국내 실시간 수집 비활성. FEED_MODE=snapshot이면 키 없이 저장본(data/feeds/kr_*)을 쓴다
LAW_API_OC=

# ── Step 3a: LLM ──
# fake(결정론·무료, 테스트용) | ollama(로컬 실모델) | openai(과금)
LLM_BACKEND=fake
# 로컬 실행용 주소. Docker는 이 값을 쓰지 않고 DOCKER_OLLAMA_BASE_URL(기본 host.docker.internal)을 쓴다
OLLAMA_BASE_URL=http://127.0.0.1:11434
# DOCKER_OLLAMA_BASE_URL=http://ollama:11434   # Ollama도 컨테이너로 띄울 때 (--profile ollama)
OLLAMA_FAST_MODEL=qwen3:8b
OLLAMA_QUALITY_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o

# ── Step 4: API ──
# v2(개선) | baseline(Before: LLM 단독)
PIPELINE_VERSION=v2
# 프론트엔드 출처 (CORS 허용 목록, 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Step 6: 평가 ──
# live | snapshot (snapshot = 실시간 호출 없이 저장된 관보 목록·본문만 사용 → 같은 입력으로 반복 평가)
FEED_MODE=live

# ── Step 6: LangSmith (관리자 대시보드: 트레이스·피드백·평가) ──
# https://smith.langchain.com → Settings → API Keys. 비워 두면 LangSmith 연동을 건너뛴다
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chem-reg-briefing

# ── Step 7: 관리자 페이지 (/admin/) ──
# 관리자 API 토큰. 비워 두면 관리자 API가 닫힌다. 예: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# ── Step 10: 정기 브리핑 ──
# true면 매주 월요일 WEEKLY_HOUR시(한국 시간) 이후 지난주(월~일) 국내외 변경 브리핑을 만든다 (Docker는 기본 true)
WEEKLY_SCHEDULE=false
WEEKLY_HOUR=9

# ── Step 12: 규제 DB 갱신 제안 ──
# 승인한 갱신(bulk 파일을 대신하는 CSV)과 갱신 후보를 두는 폴더. 비우면 data/regulations_updates (Docker는 /app/state/…)
# REG_UPDATES_DIR=
