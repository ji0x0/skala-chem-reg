# 환경변수 템플릿 — 복사해서 .env로 쓴다 (cp .env.example .env)
# .env는 API 키 같은 비밀값이 들어가므로 Git에 올리지 않는다. 이 파일만 커밋한다.
# 단계가 진행되면서 필요한 항목을 아래에 추가한다.

# ── Step 0: 공통 ──
# 로그 수준: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Step 2: 외부 규제 원문 API ──
# 법제처 국가법령정보 Open API 사용자 ID (open.law.go.kr에서 신청, 호출 서버 IP 등록 필요). 비우면 국내 실시간 조회 비활성
LAW_API_OC=

# ── Step 3a: LLM ──
# fake(결정론·무료, 테스트용) | ollama(로컬 실모델) | openai(과금)
LLM_BACKEND=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3:8b
OLLAMA_QUALITY_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o

# ── Step 4: API ──
# v2(개선) | baseline(Before: LLM 단독)
PIPELINE_VERSION=v2
# 프론트엔드 출처 (CORS 허용 목록, 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
